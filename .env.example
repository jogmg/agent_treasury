# Glimmerlock frontend environment
# The app defaults to Arc mainnet. Never put private keys in Vite env vars:
# anything prefixed with VITE_ is embedded in the client bundle.

VITE_ARC_NETWORK=mainnet

# Hermes BFF origin. Leave empty when the app and BFF share an origin (or when
# using the Vite dev proxy). The BFF is the only service that holds the Hermes
# User API key; never put that key in a VITE_* variable.
# VITE_BFF_URL=https://hermes-bff.example.com

# Arc Studio sandbox only. The Studio preview has no Hermes BFF, so it opens
# Overview and hides Chat. Add ?studioPreview=1 instead if the env cannot be set.
# VITE_STUDIO_PREVIEW=1

# Mainnet defaults (compiled in; override only for a new deployment):
# VITE_TREASURY_ADDRESS=0xf71b5d1a19d72b98675785123fae811698be6f63
# VITE_ADAPTER_ADDRESS=0x5102057330f5bb5f3e4eb0925b7d1eac8a563c23
# VITE_RECEIVER_ADDRESS=0x847F55221F30675791d2fAaf84f93B1fa86399E2
# VITE_VAULT_ADDRESS=0x8E357432CC12ff425c36432F312968aEb16112AF
# VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# VITE_TREASURY_DEPLOY_BLOCK=27153175

# Testnet demo build:
# VITE_ARC_NETWORK=testnet
# VITE_TREASURY_ADDRESS=0x5e2e3da19533ebf85bc916612eff5cdc7bf4d489
# VITE_ADAPTER_ADDRESS=0x333deccbf9091540e849b7af80f2f10b72197b71
