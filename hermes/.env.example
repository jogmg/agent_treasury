# Service configuration for the Hermes Phase 1 stack.
# Copy to .env and fill in real values. Never commit .env.

ARC_NETWORK=mainnet
TRACKED_AGENTS=0xD00fD0B006c01342522cAf4FA04D5f8910aB268c

# Postgres (private to the Compose network).
POSTGRES_DB=treasury
POSTGRES_USER=treasury
POSTGRES_PASSWORD=replace-with-a-long-random-password

# For running services directly on the host, use this URL. Compose overrides
# the host to `postgres` and injects the password.
DATABASE_URL=postgresql://treasury:replace-with-a-long-random-password@localhost:5432/treasury

# Set true only for managed Postgres that requires TLS (Fly/Railway). Keep
# false/empty for the private Compose network.
# DATABASE_SSL=true

# MCP bearer tokens. Generate each with: openssl rand -hex 32
# Must be at least 32 characters; placeholders are rejected at startup.
# Ops can read incidents/bookkeeping; user cannot.
ARC_MCP_TOKEN_OPS=replace-with-ops-token
ARC_MCP_TOKEN_USER=replace-with-user-token

# Private Discord channel webhook for deterministic monitor alerts.
DISCORD_WEBHOOK_URL=

# Optional host bind overrides. Local runs default to loopback; Compose sets
# 0.0.0.0 explicitly so containers can reach each other on the private network.
# MCP_HOST=127.0.0.1
# MONITOR_HOST=127.0.0.1

MONITOR_INTERVAL_SECONDS=60
INDEX_CHUNKS_PER_RUN=20
ALERT_COOLDOWN_SECONDS=3600
LOG_LEVEL=info

# ── Phase 2 BFF (private; expose only through HTTPS/tunnel) ─────────────────
# Public origin of the BFF. This is the SIWE domain the user signs. With a
# same-origin reverse proxy (recommended), this is also the frontend origin.
BFF_PUBLIC_ORIGIN=http://localhost:5173
# Comma-separated browser origins allowed to call the BFF with credentials.
# Defaults to BFF_PUBLIC_ORIGIN. Set this to the frontend origin when the BFF
# is served from a separate origin (for example, bff.example vs app.example).
# BFF_ALLOWED_ORIGINS=https://your-app.example
BFF_HOST=127.0.0.1
BFF_PORT=8789
# Generate with: openssl rand -hex 32
BFF_SESSION_SECRET=replace-with-a-long-random-session-secret
# Use 3600 for a one-hour wallet session.
BFF_SESSION_TTL_SECONDS=3600
BFF_NONCE_TTL_SECONDS=300
# For a cross-site BFF (different registrable domain from the frontend), use
# SameSite=None and Secure=true. Same-site subdomains can keep lax.
# BFF_COOKIE_SAMESITE=none
# BFF_COOKIE_SECURE=true
# BFF_COOKIE_DOMAIN=.example.com
# BFF_TRUST_PROXY=true
# A tool-using turn can take over a minute; keep this above the proxy timeout.
BFF_CHAT_TIMEOUT_MS=90000
BFF_CHAT_RATE_LIMIT_PER_MINUTE=20
BFF_NONCE_RATE_LIMIT_PER_MINUTE=30
# Draft intents are stored in Postgres (migration 002_intents.sql). The BFF
# returns 503 for draft actions when DATABASE_URL is unset.
BFF_INTENT_TTL_SECONDS=900
BFF_INTENT_RATE_LIMIT_PER_MINUTE=12
# Reconcile submitted intents from receipts/transactions and expire stale drafts.
# 0 disables the background sweep (the GET path still expires on read).
BFF_INTENT_MAINTENANCE_SECONDS=60

# Hermes User profile API (OpenAI-compatible). Keep this on the private
# Compose network; never publish it directly. The API key must match
# API_SERVER_KEY in profiles/user/.env.
HERMES_USER_URL=http://hermes-user:8642
HERMES_USER_API_KEY=replace-with-the-same-value-as-API_SERVER_KEY
# The standalone User gateway serves /v1. A multiplex host uses
# /p/user/v1/chat/completions instead; the BFF falls back on a route 404.
HERMES_USER_CHAT_PATH=/v1/chat/completions
# Leave unset to use the User profile's configured model/fallback chain.
# HERMES_USER_MODEL=

# Hermes container ownership and data path. Set UID/GID to your VPS user.
# HERMES_UID=1000
# HERMES_GID=1000
# HERMES_DATA_DIR=./data

# Optional RPC / Iris overrides.
# ARC_RPC_URL=https://rpc.mainnet.arc.io
# IRIS_API_URL=https://iris-api.circle.com
