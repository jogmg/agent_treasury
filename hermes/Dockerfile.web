# Static frontend + same-origin reverse proxy for the private BFF.
# Build context is the repository root:
#   docker build -f hermes/Dockerfile.web -t agent-treasury-web .

FROM node:24-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
# The frontend's Vite 6 / vite-plugin-node-polyfills peer range conflicts under
# strict npm resolution. The lockfile and local build use this same override.
RUN npm ci --legacy-peer-deps

COPY index.html postcss.config.js tailwind.config.js tsconfig.json vite.config.ts ./
COPY src ./src
COPY public ./public
COPY shared ./shared

# Same-origin deployment: leave VITE_BFF_URL unset so the browser calls
# /api/* and /auth/* on this origin and nginx proxies them to bff:8789.
ARG VITE_BFF_URL=
ENV VITE_BFF_URL=$VITE_BFF_URL
RUN npm run build


FROM nginx:1.27-alpine

COPY hermes/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
