# Hermes Ops profile secrets. This file is copied to
# data/profiles/ops/.env by bootstrap.sh and is never committed.

# Discord bot for the private Ops server. Create it in the Discord Developer
# Portal, enable Message Content Intent, and invite it to the server.
DISCORD_BOT_TOKEN=replace-with-discord-bot-token
DISCORD_ALLOWED_USERS=replace-with-your-discord-user-id
# Optional: comma-separated channel IDs. Without this, the bot can respond in
# any channel where it can read messages, but only to allowlisted users.
# DISCORD_ALLOWED_CHANNELS=
DISCORD_REQUIRE_MENTION=true

# Must match ARC_MCP_TOKEN_OPS in hermes/.env. At least 32 characters;
# replace this placeholder with the generated token.
ARC_MCP_TOKEN_OPS=replace-with-ops-token

# The LLM used by Hermes Ops. Google Gemini free-tier endpoints are configured
# in config.yaml with a ranked free-model fallback chain.
GEMINI_API_KEY=
# Optional; the provider default is the native Gemini API. Do not append
# /openai unless you deliberately want the OpenAI-compatibility path.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Kept for rollback only; the active model.provider is gemini.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Phase 1 deliberately leaves the OpenAI-compatible API server off.
API_SERVER_ENABLED=false
# API_SERVER_KEY=
# API_SERVER_PORT=8642
