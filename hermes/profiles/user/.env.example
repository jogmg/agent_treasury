# User profile secrets (Phase 2). Do not enable this profile in Phase 1.
# Use a different Discord bot and a different MCP token from Ops.

# Set this before launching; an empty allowlist is not a public-launch config.
DISCORD_ALLOWED_USERS=
DISCORD_BOT_TOKEN=
# Phase 2 public surface is API/BFF-first. If you also enable Discord,
# keep mention-only behavior and a non-empty allowlist/role list.
DISCORD_REQUIRE_MENTION=true
ARC_MCP_TOKEN_USER=
ANTHROPIC_API_KEY=
API_SERVER_ENABLED=false
