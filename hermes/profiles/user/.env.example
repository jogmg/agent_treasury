# Hermes User profile secrets (Phase 2). Keep this file on the private host.
# The profile is reached only by the BFF; do not enable a public Discord bot.

ARC_NETWORK=mainnet
ARC_RPC_URL=
IRIS_API_URL=

# Separate from ARC_MCP_TOKEN_OPS. Used by the read-only User profile.
ARC_MCP_TOKEN_USER=

# NVIDIA Build free endpoints (same provider discipline as Ops).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# BFF -> Hermes User API server. The BFF uses the same value as
# HERMES_USER_API_KEY. Generate with: openssl rand -hex 32
API_SERVER_KEY=

# The User API is private to the Compose network. Only the BFF calls it.
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
